{
  "issuer": "https://api.lihe.chat",
  "authorization_endpoint": "https://api.lihe.chat/oidc/authorize",
  "token_endpoint": "https://api.lihe.chat/oidc/token",
  "userinfo_endpoint": "https://api.lihe.chat/oidc/userinfo",
  "jwks_uri": "https://api.lihe.chat/oidc/jwks",
  "scopes_supported": ["openid", "profile", "email"],
  "response_types_supported": ["code"],
  "response_modes_supported": ["query"],
  "grant_types_supported": ["authorization_code"],
  "subject_types_supported": ["public"],
  "id_token_signing_alg_values_supported": ["RS256"],
  "token_endpoint_auth_methods_supported": ["client_secret_basic"],
  "code_challenge_methods_supported": ["S256"],
  "claims_supported": [
    "iss",
    "sub",
    "aud",
    "exp",
    "iat",
    "nonce",
    "email",
    "email_verified",
    "preferred_username",
    "name"
  ]
}
