# Optional host-side overrides for the ToCreate update controller.
# Install as /home/ubuntu/sub2api-deploy/tocreate-update-controller.env.
# The API key itself belongs in the separate mode-600 file below.

CONFLICT_RESOLVER_BASE_URL=https://api.lihe.chat
CONFLICT_RESOLVER_MODEL=gpt-5.6-luna
CONFLICT_RESOLVER_REASONING_EFFORT=max
CONFLICT_RESOLVER_API_KEY_FILE=/home/ubuntu/sub2api-deploy/secrets/conflict-resolver-api-key

# Safety and timeout limits.
CONFLICT_RESOLVER_TIMEOUT_SECONDS=900
CONFLICT_RESOLVER_MAX_FILES=12
CONFLICT_RESOLVER_MAX_FILE_BYTES=196608
CONFLICT_RESOLVER_MAX_TOTAL_BYTES=1048576
CONFLICT_RESOLVER_MAX_OUTPUT_TOKENS=65536
